---
import { Search, MapPin, Menu, X, Phone } from 'lucide-astro';

const navItems = [
  { label: 'Servicios', href: '/servicios/' },
  { label: 'Zonas', href: '/localidades/' },
  { label: 'Nosotros', href: '/sobre-nosotros/' },
  { label: 'Blog', href: '/blog/' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 frosted-glass py-4">
  <div class="max-w-7xl mx-auto px-4 md:px-8 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <div class="w-10 h-10 bg-slate-900 rounded-xl flex items-center justify-center text-white rotate-3 group-hover:rotate-0 transition-transform duration-300">
        <span class="font-bold text-xl leading-none">L</span>
      </div>
      <div class="flex flex-col">
        <span class="font-heading font-bold text-xl leading-none">Limpieza <br/> Vera Playa</span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors relative group"
        >
          {item.label}
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-slate-900 transition-all duration-300 group-hover:w-full"></span>
        </a>
      ))}
    </nav>

    <!-- Actions -->
    <div class="hidden md:flex items-center gap-4">
      <a href="tel:+34600000000" class="flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900">
        <Phone size={18} />
        <span>600 000 000</span>
      </a>
      <a href="/presupuesto/" class="btn-primary py-2.5 px-6">
        Pedir Presupuesto
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button class="md:hidden p-2 text-slate-900 z-[100] relative" id="mobile-menu-toggle" aria-label="Menu">
      <Menu size={24} class="menu-icon" />
      <X size={24} class="close-icon hidden" />
    </button>
  </div>
</header>

<!-- Mobile Menu - OUTSIDE header for proper sizing -->
<div 
  id="mobile-menu" 
  class="md:hidden"
  style="position: fixed; top: 0; left: 0; width: 100%; height: 100vh; background: white; z-index: 90; transform: translateX(100%); transition: transform 0.4s ease-in-out; overflow-y: auto;"
>
  <div style="padding: 100px 24px 40px 24px; min-height: 100%; display: flex; flex-direction: column;">
    <nav style="display: flex; flex-direction: column; gap: 16px;">
      {navItems.map(item => (
        <a 
          href={item.href} 
          style="font-size: 24px; font-weight: bold; color: #0f172a; padding: 16px 0; border-bottom: 1px solid #f1f5f9; text-decoration: none;"
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div style="margin-top: auto; padding-top: 32px; display: flex; flex-direction: column; gap: 16px;">
      <a href="tel:+34600000000" style="display: flex; align-items: center; justify-content: center; gap: 12px; font-size: 18px; font-weight: 500; color: #334155; padding: 16px; background: #f8fafc; border-radius: 12px; text-decoration: none;">
        <Phone size={20} />
        <span>600 000 000</span>
      </a>
      <a href="/presupuesto/" class="btn-primary" style="width: 100%; justify-content: center; padding: 18px; font-size: 18px;">
        Pedir Presupuesto
      </a>
    </div>
  </div>
</div>

<div class="h-20"></div>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = toggle?.querySelector('.menu-icon');
  const closeIcon = toggle?.querySelector('.close-icon');

  toggle?.addEventListener('click', () => {
    if (menu) {
      const isOpen = menu.style.transform === 'translateX(0%)';
      menu.style.transform = isOpen ? 'translateX(100%)' : 'translateX(0%)';
    }
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
    document.body.style.overflow = document.body.style.overflow === 'hidden' ? '' : 'hidden';
  });

  // Close menu when clicking a link
  const links = menu?.querySelectorAll('a');
  links?.forEach(link => {
    link.addEventListener('click', () => {
      if (menu) menu.style.transform = 'translateX(100%)';
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
    });
  });
</script>
