---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Header/Navigation.astro';
import Footer from '../components/Footer/Footer.astro';
import { Phone, Mail, MapPin, Clock, MessageSquare } from 'lucide-astro';

const title = "Contacto | Estamos aquí para ayudarte";
const description = "Contacta con Limpieza Vera Playa para cualquier consulta sobre nuestros servicios de limpieza en Vera, Garrucha, Puerto Rey y alrededores.";
---

<BaseLayout {title} {description}>
  <Navigation slot="header" />

  <section class="py-24 bg-white relative">
    <div class="absolute inset-0 linear-grid opacity-[0.2] pointer-events-none"></div>
    <div class="section-padding relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-20">
        <div>
          <h1 class="text-5xl md:text-7xl font-bold mb-8 italic">Hablemos <br/> <span class="premium-gradient-text">Sin Compromiso</span></h1>
          <p class="text-xl text-slate-500 mb-12 italic">¿Tiene alguna duda o necesita un servicio urgente? Nuestro equipo está listo para atenderle en menos de 24 horas.</p>
          
          <div class="space-y-8">
            <div class="flex gap-6 items-start">
               <div class="w-12 h-12 bg-slate-50 rounded-xl flex items-center justify-center text-slate-900 border border-slate-100">
                  <Phone size={24} />
               </div>
               <div>
                  <h4 class="font-bold text-lg mb-1">Teléfono</h4>
                  <p class="text-slate-500">950 000 000</p>
                  <p class="text-xs text-slate-400 mt-1">Lunes a Viernes, 8:00 - 20:00</p>
               </div>
            </div>
            <div class="flex gap-6 items-start">
               <div class="w-12 h-12 bg-slate-50 rounded-xl flex items-center justify-center text-slate-900 border border-slate-100">
                  <Mail size={24} />
               </div>
               <div>
                  <h4 class="font-bold text-lg mb-1">Correo Electrónico</h4>
                  <p class="text-slate-500">info@limpiezaveraplaya.com</p>
                  <p class="text-xs text-slate-400 mt-1">Respondemos en menos de 2h</p>
               </div>
            </div>
            <div class="flex gap-6 items-start">
               <div class="w-12 h-12 bg-slate-50 rounded-xl flex items-center justify-center text-slate-900 border border-slate-100">
                  <MapPin size={24} />
               </div>
               <div>
                  <h4 class="font-bold text-lg mb-1">Oficina Central</h4>
                  <p class="text-slate-500">Calle Mayor, s/n. Vera Playa, Almería.</p>
               </div>
            </div>
          </div>
        </div>

        <div class="bg-slate-50 border border-slate-100 rounded-[3rem] p-8 md:p-12">
          <form class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
               <div class="space-y-2">
                  <label class="text-xs font-bold uppercase tracking-widest text-slate-400 ml-1">Nombre Completo</label>
                  <input type="text" class="w-full px-6 py-4 bg-white border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-slate-900/5 focus:border-slate-900 transition-all" placeholder="Juan Pérez" />
               </div>
               <div class="space-y-2">
                  <label class="text-xs font-bold uppercase tracking-widest text-slate-400 ml-1">Email</label>
                  <input type="email" class="w-full px-6 py-4 bg-white border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-slate-900/5 focus:border-slate-900 transition-all" placeholder="juan@ejemplo.com" />
               </div>
            </div>
            <div class="space-y-2">
               <label class="text-xs font-bold uppercase tracking-widest text-slate-400 ml-1">¿Cómo podemos ayudarte?</label>
               <select class="w-full px-6 py-4 bg-white border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-slate-900/5 focus:border-slate-900 transition-all appearance-none">
                  <option>Limpieza de Comunidad</option>
                  <option>Gestión Vacacional</option>
                  <option>Servicio Industrial</option>
                  <option>Otro motivo</option>
               </select>
            </div>
            <div class="space-y-2">
               <label class="text-xs font-bold uppercase tracking-widest text-slate-400 ml-1">Mensaje</label>
               <textarea rows="4" class="w-full px-6 py-4 bg-white border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-slate-900/5 focus:border-slate-900 transition-all" placeholder="Cuéntanos más sobre tus necesidades..."></textarea>
            </div>
            <button class="btn-primary w-full justify-center py-5 text-lg">Enviar Mensaje</button>
            <p class="text-[10px] text-center text-slate-400">Al enviar este formulario, acepta nuestra política de privacidad y protección de datos.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
