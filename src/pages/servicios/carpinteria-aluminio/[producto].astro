---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Header/Navigation.astro';
import Footer from '../../../components/Footer/Footer.astro';
import { 
  CheckCircle2, ArrowLeft, ShieldCheck, Zap, 
  Layout, Maximize, Sun, Layers, Grid, Lock, 
  Smartphone, EyeOff, Scissors, ShoppingBag, Droplets, Box, Hotel
} from 'lucide-astro';

export async function getStaticPaths() {
  const productos = await getCollection('productos-aluminio');
  return productos.map(producto => ({
    params: { producto: producto.id },
    props: { producto }
  }));
}

const { producto } = Astro.props;
const { Content } = await render(producto);
const { title, description, icon, features, metaTitle, metaDescription } = producto.data;

const Icon = {
    Layout, Maximize, Sun, Zap, ShieldCheck, Layers, Grid, Lock, Smartphone, EyeOff, Scissors, ShoppingBag, Droplets, Box, Hotel
}[icon] || Layout;
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <Navigation slot="header" />

  <section class="relative py-24 bg-slate-50 overflow-hidden">
    <div class="absolute inset-0 linear-grid opacity-[0.2] pointer-events-none"></div>
    
    <div class="section-padding relative z-10">
      <a href="/servicios/carpinteria-metalica/" class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-slate-400 hover:text-slate-900 transition-colors mb-12 group">
        <ArrowLeft size={16} class="group-hover:-translate-x-1 transition-transform" />
        Volver a Carpintería
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
        <div>
          <div class="w-20 h-20 bg-slate-900 rounded-[2rem] flex items-center justify-center text-white shadow-2xl shadow-slate-900/20 mb-10 rotate-3">
            <Icon size={40} />
          </div>
          <h1 class="text-5xl md:text-7xl font-bold mb-8 leading-[0.9] tracking-tighter italic">
            {title} <br/> <span class="premium-gradient-text">Premium</span>
          </h1>
          <p class="text-2xl text-slate-500 leading-relaxed max-w-2xl italic mb-10">
            {description}
          </p>
          
          <div class="flex flex-wrap gap-4">
             <a href="/presupuesto/" class="btn-primary px-10 py-4 text-lg">Solicitar Cita</a>
             <a href="tel:+34657085019" class="btn-secondary px-10 py-4 text-lg text-slate-900">Llamar Ahora</a>
          </div>
        </div>

        <div class="relative">
          <div class="aspect-square bg-white rounded-[4rem] p-12 border border-slate-100 shadow-2xl rotate-2 relative overflow-hidden group">
             <div class="absolute inset-0 bg-gradient-to-br from-slate-50 to-white"></div>
             <div class="relative z-10 h-full flex flex-col justify-center">
                <h3 class="text-3xl font-bold mb-8 italic">Características <br/> Destacadas</h3>
                <div class="space-y-6">
                   {features.map(feature => (
                     <div class="flex items-center gap-4 group/item">
                        <div class="w-10 h-10 bg-slate-50 rounded-xl flex items-center justify-center text-slate-900 group-hover/item:bg-slate-900 group-hover/item:text-white transition-all">
                           <CheckCircle2 size={20} />
                        </div>
                        <span class="text-lg font-medium text-slate-600 italic group-hover/item:text-slate-900 transition-colors">{feature}</span>
                     </div>
                   ))}
                </div>
             </div>
             
             <!-- Decorative elements -->
             <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-slate-900/5 rounded-full blur-3xl"></div>
             <div class="absolute -top-10 -left-10 w-40 h-40 bg-slate-900/5 rounded-full blur-3xl"></div>
          </div>
          
          <!-- Quality Badge -->
          <div class="absolute -bottom-10 right-10 p-8 bg-slate-900 text-white rounded-3xl shadow-2xl -rotate-3 border border-white/10">
             <div class="flex items-center gap-4">
                <ShieldCheck size={32} class="text-blue-400" />
                <div>
                   <p class="text-[10px] uppercase tracking-widest font-bold text-slate-400">Garantía Vera Playa</p>
                   <p class="text-xl font-bold italic">100% Certificado</p>
                </div>
             </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="section-padding">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-slate prose-2xl max-w-none prose-headings:font-bold prose-headings:font-heading prose-p:text-slate-500 prose-p:italic prose-strong:text-slate-900 prose-strong:not-italic">
          <Content />
        </div>
        
        <div class="mt-20 p-12 bg-slate-900 rounded-[3rem] text-white relative overflow-hidden">
           <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-bl-[100%]"></div>
           <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-10">
              <div class="max-w-md">
                 <h2 class="text-4xl font-bold mb-4 italic">¿Listo para mejorar su hogar?</h2>
                 <p class="text-slate-400 italic">Ofrecemos asesoramiento técnico personalizado para encontrar la solución que mejor se adapte a su proyecto.</p>
              </div>
              <a href="/presupuesto/" class="btn-secondary px-12 py-5 text-xl whitespace-nowrap bg-white text-slate-900 hover:bg-slate-50">
                 Pedir Presupuesto
                 <Zap size={20} fill="currentColor" />
              </a>
           </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
