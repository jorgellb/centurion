---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Header/Navigation.astro';
import Footer from '../../../components/Footer/Footer.astro';
import { 
  CheckCircle2, ArrowLeft, ShieldCheck, Zap, 
  Layout, Maximize, Sun, Layers, Grid, Lock, 
  Smartphone, EyeOff, Scissors, ShoppingBag, Droplets, Box, Hotel,
  Award, Settings
} from 'lucide-astro';

export async function getStaticPaths() {
  const productos = await getCollection('productos-aluminio');
  return productos.map(producto => ({
    params: { producto: producto.id },
    props: { producto }
  }));
}

const { producto } = Astro.props;
const { Content } = await render(producto);
const { title, description, icon, features, metaTitle, metaDescription } = producto.data;

const Icon = {
    Layout, Maximize, Sun, Zap, ShieldCheck, Layers, Grid, Lock, Smartphone, EyeOff, Scissors, ShoppingBag, Droplets, Box, Hotel
}[icon] || Layout;
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <Navigation slot="header" />

  <section class="relative py-24 bg-slate-50 overflow-hidden">
    <div class="absolute inset-0 linear-grid opacity-[0.2] pointer-events-none"></div>
    
    <div class="section-padding relative z-10">
      <a href="/servicios/carpinteria-metalica/" class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-slate-400 hover:text-slate-900 transition-colors mb-12 group">
        <ArrowLeft size={16} class="group-hover:-translate-x-1 transition-transform" />
        Volver a Carpintería
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
        <div>
          <div class="w-20 h-20 bg-slate-900 rounded-[2rem] flex items-center justify-center text-white shadow-2xl shadow-slate-900/20 mb-10 rotate-3">
            <Icon size={40} />
          </div>
          <h1 class="text-5xl md:text-7xl font-bold mb-8 leading-[0.9] tracking-tighter italic">
            {title} <br/> <span class="premium-gradient-text">Premium</span>
          </h1>
          <p class="text-2xl text-slate-500 leading-relaxed max-w-2xl italic mb-10">
            {description}
          </p>
          
          <div class="flex flex-wrap gap-4">
             <a href="/presupuesto/" class="btn-primary px-10 py-4 text-lg">Solicitar Cita</a>
             <a href="tel:+34657085019" class="btn-secondary px-10 py-4 text-lg text-slate-900">Llamar Ahora</a>
          </div>
        </div>

        <div class="relative">
          <div class="aspect-square bg-white rounded-[4rem] p-12 border border-slate-100 shadow-2xl rotate-2 relative overflow-hidden group">
             <div class="absolute inset-0 bg-gradient-to-br from-slate-50 to-white"></div>
             <div class="relative z-10 h-full flex flex-col justify-center">
                <h3 class="text-3xl font-bold mb-8 italic">Características <br/> Destacadas</h3>
                <div class="space-y-6">
                   {features.map(feature => (
                     <div class="flex items-center gap-4 group/item">
                        <div class="w-10 h-10 bg-slate-50 rounded-xl flex items-center justify-center text-slate-900 group-hover/item:bg-slate-900 group-hover/item:text-white transition-all">
                           <CheckCircle2 size={20} />
                        </div>
                        <span class="text-lg font-medium text-slate-600 italic group-hover/item:text-slate-900 transition-colors">{feature}</span>
                     </div>
                   ))}
                </div>
             </div>
             
             <!-- Decorative elements -->
             <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-slate-900/5 rounded-full blur-3xl"></div>
             <div class="absolute -top-10 -left-10 w-40 h-40 bg-slate-900/5 rounded-full blur-3xl"></div>
          </div>
          
          <!-- Quality Badge -->
          <div class="absolute -bottom-10 right-10 p-8 bg-slate-900 text-white rounded-3xl shadow-2xl -rotate-3 border border-white/10">
             <div class="flex items-center gap-4">
                <ShieldCheck size={32} class="text-blue-400" />
                <div>
                   <p class="text-[10px] uppercase tracking-widest font-bold text-slate-400">Garantía Vera Playa</p>
                   <p class="text-xl font-bold italic">100% Certificado</p>
                </div>
             </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="section-padding">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
        <!-- Sidebar context/Trust -->
        <div class="lg:col-span-1 space-y-8">
           <div class="p-8 bg-slate-50 rounded-3xl border border-slate-100 sticky top-24">
              <h3 class="text-xl font-bold mb-6 italic">Por qué elegirnos</h3>
              <div class="space-y-6">
                 <div class="flex gap-4">
                    <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center text-slate-900 border border-slate-200 shrink-0">
                       <Award size={20} />
                    </div>
                    <div>
                       <p class="font-bold text-sm">Especialistas locales</p>
                       <p class="text-xs text-slate-500 italic">Conocemos las necesidades de la zona de Vera Playa.</p>
                    </div>
                 </div>
                 <div class="flex gap-4">
                    <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center text-slate-900 border border-slate-200 shrink-0">
                       <ShieldCheck size={20} />
                    </div>
                    <div>
                       <p class="font-bold text-sm">Garantía total</p>
                       <p class="text-xs text-slate-500 italic">Materiales de primera calidad y montajes certificados.</p>
                    </div>
                 </div>
                 <div class="flex gap-4">
                    <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center text-slate-900 border border-slate-200 shrink-0">
                       <Settings size={20} />
                    </div>
                    <div>
                       <p class="font-bold text-sm">Mantenimiento mínimo</p>
                       <p class="text-xs text-slate-500 italic">Soluciones pensadas para durar décadas sin esfuerzo.</p>
                    </div>
                 </div>
              </div>

              <div class="mt-10 p-6 bg-slate-900 rounded-2xl text-white">
                 <p class="text-xs uppercase tracking-widest font-bold text-slate-400 mb-2">Respuesta en 24h</p>
                 <p class="text-lg font-bold italic mb-4">¿Tiene un proyecto en mente?</p>
                 <a href="/contacto/" class="text-sm font-bold border-b border-white/20 pb-1 hover:border-white transition-all">Hable con un experto →</a>
              </div>
           </div>
        </div>

        <!-- Main Content Area -->
        <div class="lg:col-span-2">
          <div class="prose prose-slate prose-xl max-w-none prose-headings:font-bold prose-headings:font-heading prose-p:text-slate-500 prose-p:italic prose-p:leading-relaxed prose-strong:text-slate-900 prose-strong:not-italic mb-20 pb-20 border-b border-slate-100">
            <h2 class="text-3xl md:text-5xl font-bold italic mb-8">Elevando el standard <br/> de su <span class="premium-gradient-text">propiedad</span></h2>
            <Content />
          </div>

          <!-- Work Process -->
          <div class="mb-20">
             <h3 class="text-3xl font-bold mb-10 italic">Nuestro proceso de <span class="text-slate-400">trabajo</span></h3>
             <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="relative p-8 bg-slate-50 rounded-3xl border border-slate-100">
                   <span class="absolute top-6 right-8 text-4xl font-bold text-slate-200">01</span>
                   <h4 class="font-bold text-lg mb-2">Visita y Medición</h4>
                   <p class="text-sm text-slate-500 italic">Desplazamiento a su propiedad para tomar medidas exactas y asesorarle técnicamente sin compromiso.</p>
                </div>
                <div class="relative p-8 bg-slate-50 rounded-3xl border border-slate-100">
                   <span class="absolute top-6 right-8 text-4xl font-bold text-slate-200">02</span>
                   <h4 class="font-bold text-lg mb-2">Presupuesto Cerrado</h4>
                   <p class="text-sm text-slate-500 italic">Propuesta clara y detallada, sin sorpresas finales y adaptada a sus necesidades específicas.</p>
                </div>
                <div class="relative p-8 bg-slate-50 rounded-3xl border border-slate-100">
                   <span class="absolute top-6 right-8 text-4xl font-bold text-slate-200">03</span>
                   <h4 class="font-bold text-lg mb-2">Fabricación e Instalación</h4>
                   <p class="text-sm text-slate-500 italic">Uso de maquinaria de precisión y montaje por técnicos especialistas en tiempos mínimos.</p>
                </div>
                <div class="relative p-8 bg-slate-50 rounded-3xl border border-slate-100">
                   <span class="absolute top-6 right-8 text-4xl font-bold text-slate-200">04</span>
                   <h4 class="font-bold text-lg mb-2">Garantía Post-venta</h4>
                   <p class="text-sm text-slate-500 italic">Seguimiento y servicio técnico directo para asegurar su total satisfacción a largo plazo.</p>
                </div>
             </div>
          </div>
          
          <div class="mt-20 p-12 bg-slate-900 rounded-[3rem] text-white relative overflow-hidden shadow-2xl shadow-slate-900/40">
             <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-bl-[100%]"></div>
             <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-10">
                <div class="max-w-md text-center md:text-left">
                   <h2 class="text-4xl font-bold mb-4 italic text-white">¿Iniciamos su <br/> <span class="premium-gradient-text-white">transformación?</span></h2>
                   <p class="text-slate-400 italic text-lg">Deje que los expertos de Multiservicios Vera Playa conviertan su idea en una realidad tangible y duradera.</p>
                </div>
                <div class="flex flex-col gap-4 w-full md:w-auto">
                   <a href="/presupuesto/" class="btn-secondary px-12 py-5 text-xl whitespace-nowrap bg-white text-slate-900 hover:bg-slate-50 justify-center">
                      Pedir Presupuesto
                      <Zap size={20} fill="currentColor" />
                   </a>
                   <p class="text-[10px] text-center uppercase tracking-widest font-bold text-slate-500">Respuesta rápida garantizada</p>
                </div>
             </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
