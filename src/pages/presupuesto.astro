---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Header/Navigation.astro';
import Footer from '../components/Footer/Footer.astro';
import { Calculator, ArrowRight, ShieldCheck } from 'lucide-astro';

const title = "Solicitar Presupuesto Personalizado | Multiservicios Vera Playa";
const description = "Solicita un presupuesto a medida para la limpieza y mantenimiento de tu propiedad en la Costa de Almería. Sin compromiso y 100% transparente.";
---

<BaseLayout {title} {description}>
  <Navigation slot="header" />

  <section class="py-24 bg-white relative">
    <div class="absolute inset-0 linear-grid opacity-[0.2] pointer-events-none"></div>
    <div class="section-padding relative z-10">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <div class="w-16 h-16 bg-slate-900 rounded-3xl flex items-center justify-center text-white mx-auto mb-8 rotate-3">
           <Calculator size={32} />
        </div>
        <h1 class="text-5xl md:text-6xl font-bold mb-6 italic">Presupuesto en <br/> <span class="premium-gradient-text">un clic</span></h1>
        <p class="text-xl text-slate-500 italic">Complete este breve formulario y le enviaremos una propuesta detallada ajustada a sus necesidades reales.</p>
      </div>

      <div class="max-w-4xl mx-auto">
          <div class="bg-white border border-slate-100 shadow-2xl rounded-[3rem] p-8 md:p-16 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-slate-50 rounded-bl-[100%] opacity-50"></div>
            
            <form action="https://formsubmit.co/info@multiserviciosveraplaya.com" method="POST" class="space-y-12 relative z-10">
               <input type="hidden" name="_subject" value="Nueva Solicitud de Presupuesto - Web">
               <input type="hidden" name="_next" value="https://limpiezaveraplaya.com/gracias/">
               <input type="hidden" name="_captcha" value="false">

               <!-- Paso 1: Localización -->
               <div class="space-y-6">
                  <h3 class="flex items-center gap-3 text-2xl font-bold">
                     <span class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center text-sm">1</span>
                     Localización y Contacto
                  </h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                     <div class="space-y-2">
                        <label class="text-xs font-bold uppercase tracking-widest text-slate-400">Localidad</label>
                        <select name="localidad" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-slate-900 transition-all font-medium">
                           <option value="Vera Playa">Vera Playa</option>
                           <option value="Garrucha">Garrucha</option>
                           <option value="Puerto Rey">Puerto Rey</option>
                           <option value="Villaricos">Villaricos</option>
                           <option value="Palomares">Palomares</option>
                        </select>
                     </div>
                     <div class="space-y-2">
                        <label class="text-xs font-bold uppercase tracking-widest text-slate-400">Tipo de Propiedad</label>
                        <select name="propiedad" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-slate-900 transition-all font-medium">
                           <option value="Apartamento Vacacional">Apartamento Vacacional</option>
                           <option value="Comunidad de Vecinos">Comunidad de Vecinos</option>
                           <option value="Villa/Chalet">Villa/Chalet</option>
                           <option value="Local Comercial">Local Comercial</option>
                           <option value="Garaje/Parking">Garaje/Parking</option>
                        </select>
                     </div>
                  </div>
                  <div class="space-y-2">
                     <label class="text-xs font-bold uppercase tracking-widest text-slate-400">Email de Contacto</label>
                     <input type="email" name="email" required placeholder="Su email para recibir el presupuesto" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-slate-900 transition-all font-medium" />
                  </div>
               </div>

               <!-- Paso 2: Servicios -->
               <div class="space-y-6">
                  <h3 class="flex items-center gap-3 text-2xl font-bold">
                     <span class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center text-sm">2</span>
                     Servicios Requeridos
                  </h3>
                  <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
                     {['Limpieza General', 'Cerrajería 24h', 'Reformas', 'Carpintería', 'Cristales', 'Lavandería', 'Custodia de Llaves', 'Mantenimiento'].map(serv => (
                        <label class="flex items-center gap-3 p-4 bg-slate-50 rounded-2xl cursor-pointer hover:bg-slate-100 transition-all group">
                           <input type="checkbox" name="servicios[]" value={serv} class="w-5 h-5 rounded border-slate-300 text-slate-900 focus:ring-slate-900" />
                           <span class="text-sm font-medium text-slate-600 group-hover:text-slate-900">{serv}</span>
                        </label>
                     ))}
                  </div>
               </div>

               <!-- Paso 3: Detalles -->
               <div class="space-y-6">
                  <h3 class="flex items-center gap-3 text-2xl font-bold">
                     <span class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center text-sm">3</span>
                     Detalles Adicionales
                  </h3>
                  <div class="space-y-2">
                     <textarea name="detalles" rows="4" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-slate-900 transition-all" placeholder="Metros cuadrados aproximados, urgencia, descripción del trabajo..."></textarea>
                  </div>
               </div>

               <div class="pt-8 border-t border-slate-100 flex flex-col md:flex-row items-center justify-between gap-8">
                  <div class="flex items-center gap-4 text-slate-400 italic text-sm">
                     <ShieldCheck size={20} class="text-slate-900" />
                     Garantizamos confidencialidad absoluta
                  </div>
                  <button type="submit" class="btn-primary px-12 py-5 text-xl w-full md:w-auto">
                     Enviar Solicitud
                     <ArrowRight size={24} />
                  </button>
               </div>
            </form>
         </div>
         
         <div class="mt-12 text-center text-slate-400 text-sm italic">
            ¿Prefieres hablar con nosotros? Llámanos al <a href="tel:+34657085019" class="text-slate-900 font-bold hover:underline">657 085 019</a>
         </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
